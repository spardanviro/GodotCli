{
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false,
    "excludedCommands": [
      "gd command *",
      "gd status",
      "gd status *",
      "gd list",
      "gd list *",
      "gd eval *"
    ],
    "filesystem": {
      "denyWrite": [
        ".",
        "~/.gdcli/config.json",
        "~/.gdcli/instances",
        "~/.local/share/godot/export_templates",
        "~/.config/godot/editor_settings-4.tres",
        "~/.config/godot/editor_settings-4.3.tres",
        "~/.config/godot/editor_settings-4.4.tres",
        "~/.config/godot/editor_settings-4.5.tres",
        "~/.config/godot/editor_settings-4.6.tres",
        "~/.config/godot/editor_settings-4.7.tres"
      ],
      "allowWrite": [
        "~/.local/share/godot",
        "~/.cache/godot",
        "~/.config/godot",
        "~/.gdcli"
      ]
    }
  }
}
