{
  "name": "gdcli-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "cli"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build --workspace cli",
    "typecheck": "npm run typecheck --workspace cli",
    "lint": "npm run lint --workspace cli",
    "test": "npm run test --workspace cli",
    "check:versions": "node scripts/check-versions.mjs",
    "check:plugin": "node scripts/check-plugin.mjs",
    "test:plugin": "node --test \"plugin/test/*.test.mjs\"",
    "test:evals": "node --test \"evals/test/*.test.mjs\"",
    "test:bridge": "node scripts/bridge-test.mjs",
    "test:e2e": "npm run build && node scripts/cli-e2e.mjs",
    "test:windowed": "npm run build && node scripts/windowed-test.mjs",
    "test:package": "node scripts/package-test.mjs",
    "verify": "npm run check:versions && npm run check:plugin && npm run test:plugin && npm run test:evals && npm run typecheck && npm run lint && npm run test && npm run build"
  }
}
