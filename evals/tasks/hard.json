  {
    "id": "hard.zh_health_hud",
    "setup": {
      "commands": [
        [
          "command",
          "node_create",
          "--args",
          "{\"type\": \"CharacterBody2D\", \"name\": \"Player\", \"parent\": \".\", \"properties\": {\"position\": [300, 200]}}"
        ]
      ]
    },
    "prompt": [
      "给 Player 加生命值：一开始 3 点，并提供受伤函数 take_damage(amount)。生命值降到 0 时 Player 从场景里移除。",
      "左上角用一个 Label 显示 \"HP: 3\"，受伤后立刻更新成剩下的生命值。"
    ],
    "checks": [
      {
        "type": "runs_clean"
      },
      {
        "type": "play",
        "steps": [
          {
            "find": {
              "name": "Player"
            },
            "as": "player"
          },
          {
            "find": {
              "class": "Label",
              "text_like": "^\\s*HP"
            },
            "as": "label"
          },
          {
            "get": "label",
            "property": "text",
            "as": "t0"
          },
          {
            "expect": {
              "left": "$t0",
              "op": "==",
              "right": "HP: 3"
            }
          },
          {
            "call": "player",
            "method": "take_damage",
            "arguments": [
              1
            ]
          },
          {
            "wait": 0.3
          },
          {
            "get": "label",
            "property": "text",
            "as": "t1"
          },
          {
            "expect": {
              "left": "$t1",
              "op": "==",
              "right": "HP: 2"
            },
            "why": "the label follows the damage"
          },
          {
            "call": "player",
            "method": "take_damage",
            "arguments": [
              2
            ]
          },
          {
            "wait": 0.5
          },
          {
            "count": {
              "name": "Player"
            },
            "as": "left"
          },
          {
            "expect": {
              "left": "$left",
              "op": "==",
              "right": 0
            },
            "why": "no health, no Player"
          }
        ]
      }
    ],
    "reference": [
      [
        "command",
        "fs_write_text",
        "--args",
        "{\"path\": \"res://player.gd\", \"text\": \"extends CharacterBody2D\\n\\nsignal health_changed(value: int)\\n\\nvar health := 3\\n\\n\\nfunc take_damage(amount: int) -> void:\\n\\thealth = max(health - amount, 0)\\n\\thealth_changed.emit(health)\\n\\tif health == 0:\\n\\t\\tqueue_free()\\n\", \"overwrite\": true}",
        "--yes"
      ],
      [
        "command",
        "node_attach_script",
        "--args",
        "{\"path\": \"Player\", \"script\": \"res://player.gd\"}"
      ],
      [
        "command",
        "node_create",
        "--args",
        "{\"type\": \"CanvasLayer\", \"name\": \"HUD\", \"parent\": \".\"}"
      ],
      [
        "command",
        "node_create",
        "--args",
        "{\"type\": \"Label\", \"name\": \"HP\", \"parent\": \"HUD\", \"properties\": {\"text\": \"HP: 3\", \"position\": [16, 16]}}"
      ],
      [
        "command",
        "fs_write_text",
        "--args",
        "{\"path\": \"res://main.gd\", \"text\": \"extends Node2D\\n\\n\\nfunc _ready() -> void:\\n\\t$Player.health_changed.connect(_on_health_changed)\\n\\n\\nfunc _on_health_changed(value: int) -> void:\\n\\t$HUD/HP.text = \\\"HP: %d\\\" % value\\n\", \"overwrite\": true}",
        "--yes"
      ],
      [
        "command",
        "node_attach_script",
        "--args",
        "{\"path\": \".\", \"script\": \"res://main.gd\"}"
      ],
      [
        "command",
        "scene_save"
      ]
    ]
