          "--args",
          "{\"path\": \"Mover\", \"script\": \"res://mover.gd\"}"
        ]
      ]
    },
    "prompt": [
      "Add pausing: pressing Escape (the ui_cancel action) pauses the game (the scene tree) and shows a Control named \"PauseMenu\", which is hidden",
      "while playing; pressing Escape again hides it and resumes. While paused, Mover stops moving."
    ],
    "max_turns": 70,
    "checks": [
      {
        "type": "runs_clean"
      },
      {
        "type": "play",
        "steps": [
          {
            "find": {
              "name": "Mover"
            },
            "as": "mover"
          },
          {
            "find": {
              "name": "PauseMenu"
            },
            "as": "menu"
          },
          {
            "get": "menu",
            "property": "visible",
            "as": "shown0"
          },
          {
            "expect": {
              "left": "$shown0",
              "op": "==",
              "right": false
            },
            "why": "hidden while playing"
          },
          {
            "input": "ui_cancel",
            "hold": 0
          },
          {
            "wait": 0.3
          },
          {
            "release": "ui_cancel"
          },
          {
            "wait": 0.3
          },
          {
            "paused": "paused1"
          },
          {
            "expect": {
              "left": "$paused1",
              "op": "==",
              "right": true
            },
            "why": "Escape pauses"
          },
          {
            "get": "menu",
            "property": "visible",
            "as": "shown1"
          },
          {
            "expect": {
              "left": "$shown1",
              "op": "==",
              "right": true
            },
            "why": "and shows the menu"
          },
          {
            "get": "mover",
            "property": "position",
            "index": 0,
            "as": "x1"
          },
          {
            "wait": 1.0
          },
          {
            "get": "mover",
            "property": "position",
            "index": 0,
            "as": "x2"
          },
          {
            "expect": {
              "left": "$x2",
              "op": "==",
              "right": "$x1"
            },
            "why": "Mover stands still"
          },
          {
            "input": "ui_cancel",
            "hold": 0
          },
          {
            "wait": 0.3
          },
          {
            "release": "ui_cancel"
          },
          {
            "wait": 0.3
          },
          {
            "paused": "paused2"
          },
          {
            "expect": {
              "left": "$paused2",
              "op": "==",
              "right": false
            },
            "why": "Escape again resumes"
          },
          {
            "get": "menu",
            "property": "visible",
            "as": "shown2"
          },
          {
            "expect": {
              "left": "$shown2",
              "op": "==",
              "right": false
            },
            "why": "and hides the menu"
          },
          {
            "get": "mover",
            "property": "position",
            "index": 0,
            "as": "x3"
          },
          {
            "wait": 0.5
          },
          {
            "get": "mover",
            "property": "position",
            "index": 0,
            "as": "x4"
          },
          {
            "expect": {
              "left": "$x4",
              "op": ">",
              "right": "$x3"
            },
            "why": "Mover moves again"
          }
        ]
      }
    ],
    "reference": [
      [
        "command",
        "node_create",
        "--args",
        "{\"type\": \"Panel\", \"name\": \"PauseMenu\", \"parent\": \".\", \"properties\": {\"size\": [200, 120], \"position\": [220, 120]}}"
      ],
      [
        "command",
        "node_create",
        "--args",
        "{\"type\": \"Label\", \"name\": \"Label\", \"parent\": \"PauseMenu\", \"properties\": {\"text\": \"Paused\"}}"
      ],
      [
        "command",
        "fs_write_text",
        "--args",
        "{\"path\": \"res://main.gd\", \"text\": \"extends Node2D\\n\\n\\nfunc _ready() -> void:\\n\\tprocess_mode = Node.PROCESS_MODE_ALWAYS\\n\\t$Mover.process_mode = Node.PROCESS_MODE_PAUSABLE\\n\\t$PauseMenu.hide()\\n\\n\\nfunc _unhandled_input(event: InputEvent) -> void:\\n\\tif event.is_action_pressed(\\\"ui_cancel\\\"):\\n\\t\\tget_tree().paused = not get_tree().paused\\n\\t\\t$PauseMenu.visible = get_tree().paused\\n\", \"overwrite\": true}",
        "--yes"
      ],
      [
        "command",
        "node_attach_script",
        "--args",
        "{\"path\": \".\", \"script\": \"res://main.gd\"}"
      ],
      [
        "command",
        "scene_save"
      ]
    ]
  },
