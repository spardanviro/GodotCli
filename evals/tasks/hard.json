  {
    "id": "hard.audio_buses",
    "setup": {
      "files": {
        "res://audio/theme.wav": {
          "fixture": "beep.wav"
        }
      }
    },
    "prompt": [
      "Set up the game's sound mixing: a Music bus and an SFX bus that both feed Master, the Music bus 6 dB quieter than",
      "normal, and a reverb on the SFX bus. Then add an AudioStreamPlayer named \"Music\" to the main scene that plays",
      "res://audio/theme.wav on the Music bus as soon as the scene starts."
    ],
    "max_turns": 70,
    "checks": [
      {
        "type": "node",
        "path": "Music",
        "class": "AudioStreamPlayer",
        "properties": {
          "bus": "Music",
          "autoplay": true
        }
      },
      {
        "type": "expression",
        "code": "root.get_node(\"Music\").stream != null and root.get_node(\"Music\").stream.resource_path == \"res://audio/theme.wav\""
      },
      {
        "type": "expression",
        "code": "AudioServer.get_bus_index(\"Music\") > 0 and AudioServer.get_bus_index(\"SFX\") > 0"
      },
      {
        "type": "expression",
        "code": "AudioServer.get_bus_send(AudioServer.get_bus_index(\"Music\")) == \"Master\" and AudioServer.get_bus_send(AudioServer.get_bus_index(\"SFX\")) == \"Master\""
      },
      {
        "type": "expression",
        "code": "is_equal_approx(AudioServer.get_bus_volume_db(AudioServer.get_bus_index(\"Music\")), -6.0)"
      },
      {
        "type": "expression",
        "code": "helper.bus_effects(\"SFX\").has(\"AudioEffectReverb\")"
      },
      {
        "type": "runs_clean"
      }
    ],
    "reference": [
      [
        "command",
        "fs_write_text",
        "--args",
        "{\"path\": \"res://default_bus_layout.tres\", \"text\": \"[gd_resource type=\\\"AudioBusLayout\\\" load_steps=2 format=3]\\n\\n[sub_resource type=\\\"AudioEffectReverb\\\" id=\\\"AudioEffectReverb_1\\\"]\\n\\n[resource]\\nbus/1/name = &\\\"Music\\\"\\nbus/1/solo = false\\nbus/1/mute = false\\nbus/1/bypass_fx = false\\nbus/1/volume_db = -6.0\\nbus/1/send = &\\\"Master\\\"\\nbus/2/name = &\\\"SFX\\\"\\nbus/2/solo = false\\nbus/2/mute = false\\nbus/2/bypass_fx = false\\nbus/2/volume_db = 0.0\\nbus/2/send = &\\\"Master\\\"\\nbus/2/effect/0/effect = SubResource(\\\"AudioEffectReverb_1\\\")\\nbus/2/effect/0/enabled = true\\n\", \"overwrite\": true}",
        "--yes"
      ],
      [
        "command",
        "node_create",
        "--args",
        "{\"type\": \"AudioStreamPlayer\", \"name\": \"Music\", \"parent\": \".\", \"properties\": {\"stream\": {\"$res\": \"res://audio/theme.wav\"}, \"bus\": \"Music\", \"autoplay\": true}}"
      ],
      [
        "command",
        "scene_save"
      ]
    ]
  }
