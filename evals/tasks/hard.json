          {
            "find": {
              "name": "Main"
            },
            "as": "main"
          },
          {
            "find": {
              "name": "Coin"
            },
            "as": "coin"
          },
          {
            "call": "coin",
            "method": "collect"
          },
          {
            "wait": 0.3
          },
          {
