              "op": "==",
              "right": 1
            },
            "why": "one coin, one point"
          }
        ]
      }
    ],
    "reference": [
      [
        "command",
        "fs_write_text",
        "--args",
        "{\"path\": \"res://main.gd\", \"text\": \"extends Node2D\\n\\nvar score := 0\\n\\n\\nfunc _on_coin_collected() -> void:\\n\\tscore += 1\\n\", \"overwrite\": true}",
        "--yes"
      ]
    ]
  },
  {
    "id": "hard.pause_menu",
    "setup": {
      "files": {
        "res://mover.gd": [
          "extends Node2D",
          "",
          "",
          "func _process(delta: float) -> void:",
          "\tposition.x += 100.0 * delta"
        ]
      },
      "commands": [
        [
          "command",
          "node_create",
          "--args",
          "{\"type\": \"Node2D\", \"name\": \"Mover\", \"parent\": \".\"}"
        ],
        [
          "command",
