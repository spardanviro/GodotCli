[
  {
    "id": "hard.enemy_patrol_chase",
    "setup": {
      "commands": [
        [
          "command",
          "node_create",
          "--args",
          "{\"type\": \"CharacterBody2D\", \"name\": \"Player\", \"parent\": \".\", \"properties\": {\"position\": [100, 300]}}"
        ]
      ]
    },
    "prompt": [
      "Add an enemy to the main scene: a CharacterBody2D named \"Enemy\" at (500, 300) with a script that has two states.",
      "While patrolling it walks back and forth up to 100 pixels either side of where it started, at 60 pixels per second.",
      "When the node \"Player\" comes within 200 pixels it chases the player at 120 pixels per second, and it goes back to",
      "patrolling once the player is more than 300 pixels away. It is a top-down game: no gravity."
    ],
    "max_turns": 70,
    "checks": [
      {
        "type": "node",
        "path": "Enemy",
        "class": "CharacterBody2D",
        "script": true
      },
      {
        "type": "runs_clean"
      },
      {
        "type": "play",
        "steps": [
          {
            "find": {
              "name": "Enemy"
            },
            "as": "enemy"
          },
          {
            "find": {
              "name": "Player"
            },
            "as": "player"
          },
          {
            "get": "enemy",
            "property": "global_position",
            "index": 0,
            "as": "x0"
          },
          {
            "wait": 1.5
          },
          {
            "get": "enemy",
            "property": "global_position",
            "index": 0,
            "as": "x1"
          },
          {
            "expect": {
              "left": "$x1",
              "op": "!=",
              "right": "$x0"
            },
            "why": "it patrols while the player is far"
          },
          {
            "expect": {
              "left": "$x1",
              "op": ">=",
              "right": 385
            }
          },
          {
            "expect": {
              "left": "$x1",
              "op": "<=",
              "right": 615
            }
          },
          {
            "set": "player",
            "properties": {
              "global_position": [
                500,
                420
              ]
            }
          },
          {
            "distance": [
              "enemy",
              "player"
            ],
            "as": "d0"
          },
          {
            "wait": 1.0
          },
          {
            "distance": [
              "enemy",
              "player"
            ],
            "as": "d1"
          },
          {
            "expect": {
              "left": "$d1",
              "op": "<",
              "right": "$d0",
              "scale": 0.7
            },
            "why": "it closes in on a near player"
          },
          {
            "set": "player",
            "properties": {
              "global_position": [
                1400,
                300
              ]
            }
          },
          {
            "wait": 2.0
          },
          {
            "get": "enemy",
            "property": "global_position",
            "index": 0,
            "as": "x2"
          },
          {
            "wait": 1.0
          },
          {
            "get": "enemy",
            "property": "global_position",
            "index": 0,
            "as": "x3"
          },
          {
            "expect": {
              "left": "$x3",
              "op": "!=",
              "right": "$x2"
            },
            "why": "it keeps moving after giving up"
          },
          {
            "expect": {
              "left": "$x3",
              "op": "<",
              "right": "$x2",
              "plus": 90
            },
            "why": "it does not chase a player 900 pixels away"
          }
        ]
      }
    ],
    "reference": [
      [
        "command",
        "node_create",
        "--args",
        "{\"type\": \"CharacterBody2D\", \"name\": \"Enemy\", \"parent\": \".\", \"properties\": {\"position\": [500, 300]}}"
      ],
      [
        "command",
        "node_create",
        "--args",
        "{\"type\": \"CollisionShape2D\", \"name\": \"Shape\", \"parent\": \"Enemy\", \"properties\": {\"shape\": {\"$new\": \"CircleShape2D\", \"properties\": {\"radius\": 12}}}}"
      ],
      [
        "command",
        "fs_write_text",
        "--args",
        "{\"path\": \"res://enemy.gd\", \"text\": \"extends CharacterBody2D\\n\\nenum State { PATROL, CHASE }\\n\\n@export var patrol_speed := 60.0\\n@export var chase_speed := 120.0\\n@export var patrol_range := 100.0\\n@export var chase_radius := 200.0\\n@export var give_up_radius := 300.0\\n\\nvar state := State.PATROL\\nvar start_x := 0.0\\nvar direction := 1.0\\n@onready var player: Node2D = get_parent().get_node_or_null(\\\"Player\\\")\\n\\n\\nfunc _ready() -> void:\\n\\tstart_x = global_position.x\\n\\n\\nfunc _physics_process(_delta: float) -> void:\\n\\tif player == null:\\n\\t\\treturn\\n\\tvar distance := global_position.distance_to(player.global_position)\\n\\tif state == State.PATROL and distance < chase_radius:\\n\\t\\tstate = State.CHASE\\n\\telif state == State.CHASE and distance > give_up_radius:\\n\\t\\tstate = State.PATROL\\n\\tif state == State.CHASE:\\n\\t\\tvelocity = global_position.direction_to(player.global_position) * chase_speed\\n\\telse:\\n\\t\\tif global_position.x > start_x + patrol_range:\\n\\t\\t\\tdirection = -1.0\\n\\t\\telif global_position.x < start_x - patrol_range:\\n\\t\\t\\tdirection = 1.0\\n\\t\\tvelocity = Vector2(direction * patrol_speed, 0.0)\\n\\tmove_and_slide()\\n\", \"overwrite\": true}",
        "--yes"
      ],
      [
        "command",
        "node_attach_script",
        "--args",
        "{\"path\": \"Enemy\", \"script\": \"res://enemy.gd\"}"
      ],
      [
        "command",
        "scene_save"
      ]
    ]
  },
  {
    "id": "hard.tile_platformer",
    "setup": {
      "files": {
        "res://art/tiles.png": {
          "fixture": "tiles.png"
        },
        "res://art/hero_walk.png": {
          "fixture": "tiles.png"
        }
      }
    },
    "prompt": [
      "Make a small platformer level in the main scene (the screen is 640x360). The floor is a TileMapLayer built from",
      "the 32x32 tile sheet res://art/tiles.png: a full row of tiles along the bottom of the screen that a character can stand on.",
      "The player is a CharacterBody2D starting at (100, 200) that falls onto the floor, walks left and right with the arrow keys",
      "and jumps with Space. It shows an AnimatedSprite2D with a \"walk\" animation made of the two 32x32 frames in",
      "res://art/hero_walk.png at 8 frames per second."
    ],
    "max_turns": 80,
    "checks": [
      {
        "type": "node_count",
        "class": "TileMapLayer",
        "min": 1
      },
      {
        "type": "expression",
        "code": "helper.find(root, \"TileMapLayer\")[0].tile_set != null and helper.find(root, \"TileMapLayer\")[0].tile_set.get_physics_layers_count() > 0 and helper.find(root, \"TileMapLayer\")[0].get_used_cells().size() >= 20"
      },
      {
        "type": "node_count",
        "class": "CharacterBody2D",
        "min": 1
      },
      {
        "type": "expression",
        "code": "helper.find(helper.find(root, \"CharacterBody2D\")[0], \"AnimatedSprite2D\").size() > 0 and helper.find(helper.find(root, \"CharacterBody2D\")[0], \"AnimatedSprite2D\")[0].sprite_frames != null and helper.find(helper.find(root, \"CharacterBody2D\")[0], \"AnimatedSprite2D\")[0].sprite_frames.get_frame_count(\"walk\") == 2"
      },
      {
        "type": "expression",
        "code": "is_equal_approx(helper.find(helper.find(root, \"CharacterBody2D\")[0], \"AnimatedSprite2D\")[0].sprite_frames.get_animation_speed(\"walk\"), 8.0)"
      },
      {
        "type": "runs_clean"
      },
      {
        "type": "play",
        "steps": [
          {
            "find": {
              "class": "CharacterBody2D"
            },
            "as": "player"
          },
          {
            "wait": 2.0
          },
          {
            "get": "player",
            "property": "global_position",
            "index": 1,
            "as": "y1"
          },
          {
            "wait": 0.5
          },
          {
            "get": "player",
            "property": "global_position",
            "index": 1,
            "as": "y2"
          },
          {
            "expect": {
              "left": "$y2",
              "op": "==",
              "right": "$y1"
            },
            "why": "it has landed and stays put"
          },
          {
            "expect": {
              "left": "$y1",
              "op": ">",
              "right": 200
            },
            "why": "it fell from where it started"
          },
          {
            "expect": {
              "left": "$y1",
              "op": "<",
              "right": 360
            },
            "why": "onto the floor, not through it"
          }
        ]
      },
      {
        "type": "game",
        "class": "CharacterBody2D",
        "actions_any": [
          "jump",
          "player_jump",
          "ui_accept",
          "ui_up",
          "move_up",
          "up"
        ],
        "hold": 0.15,
        "after": 0.3,
        "expect": "rises",
        "min": 20
      },
      {
        "type": "game",
        "class": "CharacterBody2D",
        "actions_any": [
          "move_right",
          "right",
          "ui_right",
          "player_right",
          "walk_right",
          "run_right"
        ],
        "hold": 0.6,
        "after": 0.1,
        "expect": "moves_right",
        "min": 20
      },
      {
        "type": "transcript_lacks",
        "pattern": "\\b(gd|gdcli)(\\.exe)?\\s+eval\\b|\"(command|name)\":\"eval\""
      }
    ],
    "reference": [
      [
        "command",
        "project_input_map_set",
        "--args",
        "{\"action\": \"move_left\", \"events\": [{\"key\": \"Left\"}]}",
        "--yes"
      ],
      [
        "command",
        "project_input_map_set",
        "--args",
        "{\"action\": \"move_right\", \"events\": [{\"key\": \"Right\"}]}",
        "--yes"
      ],
      [
        "command",
        "project_input_map_set",
        "--args",
        "{\"action\": \"jump\", \"events\": [{\"key\": \"Space\"}]}",
        "--yes"
      ],
      [
        "command",
        "node_create",
        "--args",
        "{\"type\": \"TileMapLayer\", \"name\": \"Floor\", \"parent\": \".\"}"
      ],
      [
        "command",
        "tileset_add_atlas",
        "--args",
        "{\"layer\": \"Floor\", \"texture\": \"res://art/tiles.png\", \"tile_size\": [32, 32], \"collision\": true}"
      ],
      [
        "command",
        "tilemap_set_cells",
        "--args",
        "{\"layer\": \"Floor\", \"rect\": [0, 10, 20, 1], \"atlas\": [0, 0]}"
      ],
      [
        "command",
        "node_create",
        "--args",
        "{\"type\": \"CharacterBody2D\", \"name\": \"Player\", \"parent\": \".\", \"properties\": {\"position\": [100, 200]}}"
      ],
      [
        "command",
        "node_create",
        "--args",
        "{\"type\": \"CollisionShape2D\", \"name\": \"Shape\", \"parent\": \"Player\", \"properties\": {\"shape\": {\"$new\": \"RectangleShape2D\", \"properties\": {\"size\": [24, 30]}}}}"
      ],
      [
        "command",
        "node_create",
        "--args",
        "{\"type\": \"AnimatedSprite2D\", \"name\": \"Sprite\", \"parent\": \"Player\"}"
      ],
      [
        "command",
        "sprite_frames_create",
        "--args",
        "{\"node\": \"Player/Sprite\", \"autoplay\": \"walk\", \"animations\": [{\"name\": \"walk\", \"sheet\": \"res://art/hero_walk.png\", \"hframes\": 2, \"fps\": 8, \"loop\": true}]}"
      ],
      [
        "command",
        "fs_write_text",
        "--args",
        "{\"path\": \"res://player.gd\", \"text\": \"extends CharacterBody2D\\n\\n@export var speed := 220.0\\n@export var jump_velocity := -420.0\\n\\nvar gravity: float = ProjectSettings.get_setting(\\\"physics/2d/default_gravity\\\")\\n\\n\\nfunc _physics_process(delta: float) -> void:\\n\\tif not is_on_floor():\\n\\t\\tvelocity.y += gravity * delta\\n\\tif Input.is_action_just_pressed(\\\"jump\\\") and is_on_floor():\\n\\t\\tvelocity.y = jump_velocity\\n\\tvelocity.x = Input.get_axis(\\\"move_left\\\", \\\"move_right\\\") * speed\\n\\tmove_and_slide()\\n\", \"overwrite\": true}",
        "--yes"
      ],
      [
        "command",
        "node_attach_script",
        "--args",
        "{\"path\": \"Player\", \"script\": \"res://player.gd\"}"
      ],
      [
        "command",
        "scene_save"
      ]
    ]
  },
  {
    "id": "hard.spawner_cap",
    "prompt": "Make the main scene spawn coins: every 0.5 seconds add a new Area2D coin, in the group \"coins\", at a random position inside the 640x360 screen, but never have more than 5 coins at once.",
    "checks": [
      {
        "type": "runs_clean"
      },
      {
        "type": "play",
        "steps": [
          {
            "wait": 4.5
          },
          {
            "count": {
              "group": "coins",
              "class": "Area2D"
            },
            "as": "n1"
          },
          {
            "expect": {
              "left": "$n1",
              "op": "==",
              "right": 5
            },
            "why": "five coins after a few seconds"
          },
          {
            "wait": 1.5
          },
          {
            "count": {
              "group": "coins",
              "class": "Area2D"
            },
            "as": "n2"
          },
          {
            "expect": {
              "left": "$n2",
              "op": "==",
              "right": 5
            },
            "why": "and never more"
          }
        ]
      }
    ],
    "reference": [
      [
        "command",
        "fs_write_text",
        "--args",
        "{\"path\": \"res://main.gd\", \"text\": \"extends Node2D\\n\\nconst MAX_COINS := 5\\n\\n\\nfunc _ready() -> void:\\n\\tvar timer := Timer.new()\\n\\ttimer.wait_time = 0.5\\n\\ttimer.autostart = true\\n\\ttimer.timeout.connect(_spawn)\\n\\tadd_child(timer)\\n\\n\\nfunc _spawn() -> void:\\n\\tif get_tree().get_nodes_in_group(\\\"coins\\\").size() >= MAX_COINS:\\n\\t\\treturn\\n\\tvar coin := Area2D.new()\\n\\tcoin.add_to_group(\\\"coins\\\")\\n\\tcoin.position = Vector2(randf() * 640.0, randf() * 360.0)\\n\\tvar shape := CollisionShape2D.new()\\n\\tvar circle := CircleShape2D.new()\\n\\tcircle.radius = 8.0\\n\\tshape.shape = circle\\n\\tcoin.add_child(shape)\\n\\tadd_child(coin)\\n\", \"overwrite\": true}",
        "--yes"
      ],
      [
        "command",
        "node_attach_script",
        "--args",
        "{\"path\": \".\", \"script\": \"res://main.gd\"}"
      ],
      [
        "command",
        "scene_save"
      ]
    ]
  },
  {
    "id": "hard.menu_to_level",
    "setup": {
      "root": "Control"
    },
    "prompt": [
      "Turn the main scene into a start menu with a \"Play\" button that has keyboard focus when the menu opens.",
      "Pressing it switches to a new level scene res://levels/level1.tscn whose root is a Node2D named \"Level1\" with a Label that says \"Level 1\"."
    ],
    "checks": [
      {
        "type": "node",
        "scene": "res://levels/level1.tscn",
        "path": ".",
        "class": "Node2D"
      },
      {
        "type": "expression",
        "scene": "res://levels/level1.tscn",
        "code": "root.name == \"Level1\" and helper.find(root, \"Label\").size() > 0 and helper.find(root, \"Label\")[0].text == \"Level 1\""
      },
      {
        "type": "play",
        "steps": [
          {
            "find": [
              {
                "class": "Button",
                "text_like": "play"
              },
              {
                "class": "Button",
                "name_like": "play"
              }
            ],
            "as": "button"
          },
          {
            "call": "button",
            "method": "emit_signal",
            "arguments": [
              "pressed"
            ]
          },
          {
            "find": {
              "name": "Level1"
            },
            "as": "level",
            "timeout": 10
          }
        ]
      },
      {
        "type": "play",
        "steps": [
          {
            "input": "ui_accept",
            "hold": 0.1
          },
          {
            "find": {
              "name": "Level1"
            },
            "as": "level",
            "timeout": 10
          }
        ]
      }
    ],
    "reference": [
      [
        "command",
        "scene_new",
        "--args",
        "{\"path\": \"res://levels/level1.tscn\", \"root_type\": \"Node2D\", \"root_name\": \"Level1\"}"
      ],
      [
        "command",
        "node_create",
        "--args",
        "{\"type\": \"Label\", \"name\": \"Title\", \"parent\": \".\", \"properties\": {\"text\": \"Level 1\"}}"
      ],
      [
        "command",
        "scene_save"
      ],
      [
        "command",
        "scene_open",
        "--args",
        "{\"path\": \"res://main.tscn\"}"
      ],
      [
        "command",
        "node_create",
        "--args",
        "{\"type\": \"Button\", \"name\": \"Play\", \"parent\": \".\", \"properties\": {\"text\": \"Play\", \"position\": [280, 160], \"size\": [80, 32]}}"
      ],
      [
        "command",
        "fs_write_text",
        "--args",
        "{\"path\": \"res://menu.gd\", \"text\": \"extends Control\\n\\n\\nfunc _ready() -> void:\\n\\t$Play.grab_focus()\\n\\t$Play.pressed.connect(_on_play_pressed)\\n\\n\\nfunc _on_play_pressed() -> void:\\n\\tget_tree().change_scene_to_file(\\\"res://levels/level1.tscn\\\")\\n\", \"overwrite\": true}",
        "--yes"
      ],
      [
        "command",
        "node_attach_script",
        "--args",
        "{\"path\": \".\", \"script\": \"res://menu.gd\"}"
      ],
      [
        "command",
        "scene_save"
      ]
    ]
  },
  {
    "id": "hard.save_high_score",
    "prompt": [
      "Give the main scene's root a script with an integer variable high_score (0 at first) and two functions:",
      "save_game() writes it to user://save.json as {\"high_score\": <value>}, and load_game() reads it back.",
      "The game loads the saved value when it starts."
    ],
    "checks": [
      {
        "type": "runs_clean"
      },
      {
        "type": "play",
        "steps": [
          {
            "find": {
              "name": "Main"
            },
            "as": "main"
          },
          {
            "set": "main",
            "properties": {
              "high_score": "$rand"
            }
          },
          {
            "call": "main",
            "method": "save_game"
          },
          {
            "restart": true
          },
          {
            "find": {
              "name": "Main"
            },
            "as": "main"
          },
          {
            "get": "main",
            "property": "high_score",
            "as": "loaded"
          },
          {
            "expect": {
              "left": "$loaded",
              "op": "==",
              "right": "$rand"
            },
            "why": "the value saved before the restart"
          }
        ]
      }
    ],
    "reference": [
      [
        "command",
        "fs_write_text",
        "--args",
        "{\"path\": \"res://main.gd\", \"text\": \"extends Node2D\\n\\nconst SAVE_PATH := \\\"user://save.json\\\"\\n\\nvar high_score := 0\\n\\n\\nfunc _ready() -> void:\\n\\tload_game()\\n\\n\\nfunc save_game() -> void:\\n\\tvar file := FileAccess.open(SAVE_PATH, FileAccess.WRITE)\\n\\tfile.store_string(JSON.stringify({\\\"high_score\\\": high_score}))\\n\\n\\nfunc load_game() -> void:\\n\\tif not FileAccess.file_exists(SAVE_PATH):\\n\\t\\treturn\\n\\tvar data: Variant = JSON.parse_string(FileAccess.get_file_as_string(SAVE_PATH))\\n\\tif data is Dictionary and data.has(\\\"high_score\\\"):\\n\\t\\thigh_score = int(data[\\\"high_score\\\"])\\n\", \"overwrite\": true}",
        "--yes"
      ],
      [
        "command",
        "node_attach_script",
        "--args",
        "{\"path\": \".\", \"script\": \"res://main.gd\"}"
      ],
      [
        "command",
        "scene_save"
      ]
    ]
  },
  {
    "id": "hard.debug_double_score",
    "setup": {
      "files": {
