; Development and test project for the gdcli bridge addon.
; Only addons/gdcli is shipped to users.

config_version=5

[application]

config/name="gdcli bridge dev"

[autoload]

GdcliGame="*res://addons/gdcli/runtime/game_agent.gd"

[editor]

; Lets the tests run the game from a headless editor on a machine without a display.
run/main_run_args="--headless"

[editor_plugins]

enabled=PackedStringArray("res://addons/gdcli/plugin.cfg")
